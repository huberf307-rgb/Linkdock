// Cloudflare Workers deployment for Linkdock (linkdock.<account>.workers.dev).
// The repo root holds the static app; worker/index.js only answers /api/*.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkdock",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
